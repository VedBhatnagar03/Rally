# Copy to .env.local. Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# true = UI runs on lib/mock. false = UI hits Supabase unless data source is fastify.
NEXT_PUBLIC_RALLY_USE_MOCKS=true

# Optional: set to fastify to point the dev harness at the secure API service.
NEXT_PUBLIC_RALLY_DATA_SOURCE=mock
NEXT_PUBLIC_RALLY_API_URL=http://localhost:4000
